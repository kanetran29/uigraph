{
  "name": "@ui-graph/adapter-react",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ui-graph/core": "workspace:*",
    "ts-morph": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "description": "React (react-router v5/v6/data-router) static extraction for UI-graph.",
  "keywords": [
    "ui-graph",
    "ui-transition-graph",
    "static-analysis",
    "mcp",
    "ai-agents",
    "playwright",
    "e2e-testing",
    "test-generation",
    "typescript",
    "react",
    "react-router"
  ],
  "author": "Kane Tran",
  "license": "MIT",
  "homepage": "https://github.com/kanetran29/uigraph#readme",
  "bugs": {
    "url": "https://github.com/kanetran29/uigraph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanetran29/uigraph.git",
    "directory": "packages/adapter-react"
  }
