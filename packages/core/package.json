{
  "name": "@ui-graph/core",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "description": "Framework-agnostic UI transition graph IR + pure ops (validate, overlay, diff, plan_path, coverage, trust tiers).",
  "keywords": [
    "ui-graph",
    "ui-transition-graph",
    "static-analysis",
    "mcp",
    "ai-agents",
    "playwright",
    "e2e-testing",
    "test-generation",
    "typescript",
    "ir",
    "graph",
    "coverage"
  ],
  "author": "Kane Tran",
  "license": "MIT",
  "homepage": "https://github.com/kanetran29/uigraph#readme",
  "bugs": {
    "url": "https://github.com/kanetran29/uigraph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanetran29/uigraph.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
