{
  "name": "@ui-graph/cli",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "uigraph": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsup",
    "uigraph": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ui-graph/core": "workspace:*",
    "@ui-graph/adapter-react": "workspace:*",
    "@ui-graph/adapter-angular": "workspace:*",
    "@ui-graph/adapter-vue": "workspace:*",
    "@ui-graph/adapter-next": "workspace:*",
    "@ui-graph/mcp": "workspace:*",
    "commander": "catalog:"
  },
  "optionalDependencies": {
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:",
    "@types/node": "catalog:"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "uigraph": "./dist/cli.js"
    }
  },
  "description": "UI-graph CLI: map, verify, login, dash, gen, diff, serve, mcp — extract and verify your app's UI transition graph.",
  "keywords": [
    "ui-graph",
    "ui-transition-graph",
    "static-analysis",
    "mcp",
    "ai-agents",
    "playwright",
    "e2e-testing",
    "test-generation",
    "typescript",
    "cli"
  ],
  "author": "Kane Tran",
  "license": "MIT",
  "homepage": "https://github.com/kanetran29/uigraph#readme",
  "bugs": {
    "url": "https://github.com/kanetran29/uigraph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanetran29/uigraph.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
