{
  "name": "@ui-graph/cli",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "uigraph": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsup",
    "uigraph": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ui-graph/core": "workspace:*",
    "@ui-graph/adapter-react": "workspace:*",
    "@ui-graph/adapter-angular": "workspace:*",
    "@ui-graph/adapter-vue": "workspace:*",
    "@ui-graph/adapter-next": "workspace:*",
    "@ui-graph/mcp": "workspace:*",
    "commander": "catalog:"
  },
  "optionalDependencies": {
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:",
    "@types/node": "catalog:"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "uigraph": "./dist/cli.js"
    }
  }
}
