{
  "name": "@ui-graph/mcp",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ui-graph/core": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "description": "Model-free stdio MCP server exposing the verified UI graph to any agent (27 tools).",
  "keywords": [
    "ui-graph",
    "ui-transition-graph",
    "static-analysis",
    "mcp",
    "ai-agents",
    "playwright",
    "e2e-testing",
    "test-generation",
    "typescript",
    "model-context-protocol",
    "stdio"
  ],
  "author": "Kane Tran",
