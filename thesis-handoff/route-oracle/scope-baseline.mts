// What scope attribution discriminates, measured against the trivial alternative.
//
// RQ3 reports that attribution recovers constructs without lowering must-tier precision. That
// is only informative if the attribution is narrow, because the widest possible attribution ---
// assign every navigation site to every screen --- recovers every construct by construction and
// is useless: the per-screen query would return the whole site list on every screen, and an
// unguarded shared site would yield a must edge from screens that never render it, so the
// soundness claim would fail by construction rather than be tested.
//
// So the figure this emits is the ratio between the two: how many (site, screen) attributions
// the analysis computes, against how many the trivial baseline would. A scope anchor stands for
// the screens scopeMembers names, so an edge anchored at one is counted over its members rather
// than over its anchor; counting only screen-anchored edges understates the analysis's breadth
// and so overstates this ratio.
import { DatabaseSync } from 'node:sqlite'
import { scopeMembers } from '@ui-graph/core'

type Row = {
  slug: string
  screens: number
  sites: number
  attributed: number
  trivial: number
}

const rows: Row[] = []

for (const dbPath of process.argv.slice(2).filter((a) => !a.startsWith('--'))) {
  const db = new DatabaseSync(dbPath)
  const g = JSON.parse((db.prepare("select json from docs where key='graph'").get() as any).json)
  const byId = new Map<string, any>(g.nodes.map((n: any) => [n.id, n]))
  // The same screen predicate the scope oracle uses, so the two tables count one corpus. The
  // catch-all route is a screen node but answers no address of its own, and counting it would
  // put a different screen total in this table than in Table~ref{tab:scope}.
  const screens = new Set<string>(g.nodes
    .filter((n: any) => n.kind === 'screen' && typeof n.route === 'string' && n.route.startsWith('/'))
    .map((n: any) => n.id))

  // A site is a source construct, identified by the file and line a witness cites. One
  // construct can produce several edges and one edge can cite several constructs, so the
  // mapping is built from every witness rather than from the edge list.
  const siteScreens = new Map<string, Set<string>>()
  for (const e of g.edges) {
    const from = byId.get(e.from)
    if (!from) continue
    const sources = (from.kind === 'scope' ? scopeMembers(g, from) : [e.from]).filter((s: string) => screens.has(s))
    if (!sources.length) continue
    for (const w of [e.witness, ...((e.mergedWitnesses as any[]) ?? [])]) {
      if (!w || w.source !== 'static' || !w.file) continue
      const k = `${w.file}:${w.loc?.line ?? '?'}`
      const set = siteScreens.get(k) ?? new Set<string>()
      for (const s of sources) set.add(s)
      siteScreens.set(k, set)
    }
  }

  const parts = dbPath.split('/')
  const i = parts.lastIndexOf('corpus')
  const slug = i >= 0 && parts[i + 1] ? parts[i + 1]! : parts.slice(-2, -1)[0] || dbPath
  const sites = siteScreens.size
  const attributed = [...siteScreens.values()].reduce((a, s) => a + s.size, 0)
  rows.push({ slug, screens: screens.size, sites, attributed, trivial: sites * screens.size })
  console.error(`  ${slug.padEnd(11)} screens=${String(screens.size).padStart(3)} sites=${String(sites).padStart(4)} ` +
    `attributed=${String(attributed).padStart(6)} trivial=${String(sites * screens.size).padStart(7)} ` +
    `mean scope=${sites ? (attributed / sites).toFixed(2) : 'n/a'}`)
}

// The chapter states these figures, so they are emitted rather than read off a console.
if (process.argv.includes('--tex')) {
  if (!rows.length) throw new Error('no database was read, so the baseline table would be empty; pass one uigraph.db per application')
  const empty = rows.filter((r) => !r.sites || !r.screens)
  if (empty.length) throw new Error(`${empty.map((r) => r.slug).join(', ')} yielded no site or no screen, so no ratio can be formed for them`)
  // A mean scope wider than the screen set would mean a site was attributed to a screen twice,
  // which the set membership forbids; checked rather than assumed, since the sources of an
  // edge are expanded through a scope anchor and a member list could in principle repeat.
  const broken = rows.filter((r) => r.attributed > r.trivial)
  if (broken.length) throw new Error(`${broken.map((r) => r.slug).join(', ')} attributed more (site, screen) pairs than the all-screens baseline, which is impossible`)

  // How much narrower the computed attribution is than the all-screens baseline. A factor
  // near one means the analysis attributed the average site to most of the screen set, so the
  // per-screen query discriminates little; that application is the one the chapter names.
  const fac = (r: Row) => r.trivial / r.attributed
  const sharpest = rows.reduce((a, r) => (fac(r) > fac(a) ? r : a))
  const bluntest = rows.reduce((a, r) => (fac(r) < fac(a) ? r : a))

  let out = '% Generated by scope-baseline.mts. Do not edit by hand.\n'
  out += '\\newcommand{\\TabScopeBaseline}{%\n\\begin{tabular}{@{}lrrrrr@{}}\n\\toprule\n'
  out += 'Application & Screens & Sites & \\shortstack[r]{Attributed\\\\pairs} & '
  out += '\\shortstack[r]{Mean\\\\scope} & \\shortstack[r]{All-screens\\\\pairs} \\\\\n\\midrule\n'
  for (const r of rows) {
    out += `${r.slug} & ${r.screens} & ${r.sites} & ${r.attributed} & `
    out += `${(r.attributed / r.sites).toFixed(2)} & ${r.trivial} \\\\\n`
  }
  out += '\\bottomrule\n\\end{tabular}}\n'
  out += `\\newcommand{\\BaselineApps}{${rows.length}}\n`
  out += `\\newcommand{\\BaselineFactorMin}{${fac(bluntest).toFixed(1)}}\n`
  out += `\\newcommand{\\BaselineFactorMax}{${fac(sharpest).toFixed(1)}}\n`
  out += `\\newcommand{\\BaselineBluntest}{${bluntest.slug}}\n`
  out += `\\newcommand{\\BaselineBluntestScope}{${(bluntest.attributed / bluntest.sites).toFixed(1)}}\n`
  out += `\\newcommand{\\BaselineBluntestScreens}{${bluntest.screens}}\n`
  out += `\\newcommand{\\BaselineBluntestShare}{${((bluntest.attributed / bluntest.sites / bluntest.screens) * 100).toFixed(0)}\\,\\%}\n`
  out += `\\newcommand{\\BaselineSharpest}{${sharpest.slug}}\n`
  out += `\\newcommand{\\BaselineSharpestAttributed}{${sharpest.attributed}}\n`
  out += `\\newcommand{\\BaselineSharpestTrivial}{${sharpest.trivial}}\n`
  out += `\\newcommand{\\BaselineMeanScopeMin}{${rows.reduce((a, r) => Math.min(a, r.attributed / r.sites), Infinity).toFixed(1)}}\n`
  out += `\\newcommand{\\BaselineMeanScopeMax}{${rows.reduce((a, r) => Math.max(a, r.attributed / r.sites), 0).toFixed(1)}}\n`
  process.stdout.write(out)
}
