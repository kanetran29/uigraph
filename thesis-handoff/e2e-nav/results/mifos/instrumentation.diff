 5 function patternOf(router: Router): string {
 6   const parts: string[] = [];
 7   let node: ActivatedRouteSnapshot | null = router.routerState.snapshot.root;
 8   while (node) {
 9     const p = node.routeConfig?.path;
10     if (p) parts.push(p);
11     node = node.firstChild;
12   }
13   return '/' + parts.join('/');
14 }
