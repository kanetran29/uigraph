20   const post = (rec: Record<string, unknown>) =>
21     fetch(ENDPOINT, {
22       method: 'POST',
23       headers: { 'content-type': 'application/json' },
24       body: JSON.stringify(rec),
25       keepalive: true,
26     }).catch(() => {});
27 
28   router.events.subscribe((e: Event) => {
29     const testTitle = (window as any).__testTitle ?? null;
30     if (e instanceof NavigationStart) {
31       const extras = router.getCurrentNavigation()?.extras;
32       current = {
