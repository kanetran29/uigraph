44         url: e.url,
45         urlAfterRedirects: e.urlAfterRedirects,
46         trigger: current?.trigger ?? null,
47         replaceUrl: current?.replaceUrl ?? null,
48         skipLocationChange: current?.skipLocationChange ?? null,
49         fromUrl: prev?.url ?? null,
50         fromPattern: prev?.pattern ?? null,
51         pattern,
52         ts: Date.now(),
53         testTitle,
54       });
55       prev = { url: e.urlAfterRedirects, pattern };
56     } else if (e instanceof NavigationCancel) {
57       post({ type: 'NavigationCancel', id: e.id, url: e.url, code: e.code, reason: e.reason, trigger: current?.trigger ?? null, ts: Date.now(), testTitle });
58     } else if (e instanceof NavigationError) {
59       post({ type: 'NavigationError', id: e.id, url: e.url, error: String(e.error), trigger: current?.trigger ?? null, ts: Date.now(), testTitle });
