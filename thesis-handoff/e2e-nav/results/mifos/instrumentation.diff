35         replaceUrl: extras?.replaceUrl,
36         skipLocationChange: extras?.skipLocationChange,
37       };
38       post({ type: 'NavigationStart', id: e.id, url: e.url, trigger: e.navigationTrigger ?? null, replaceUrl: extras?.replaceUrl ?? null, skipLocationChange: extras?.skipLocationChange ?? null, ts: Date.now(), testTitle });
39     } else if (e instanceof NavigationEnd) {
40       const pattern = patternOf(router);
41       post({
42         type: 'NavigationEnd',
